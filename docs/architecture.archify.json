  "cards": [
    {
      "dot": "emerald",
      "title": "Read In This Order",
      "items": [
        "engine.py: one step = schedule, forward, sample",
        "scheduler.py + block_manager.py: who runs, where KV lives",
        "model.py, then kernels/: the actual GPU math"
      ]
    },
    {
      "dot": "cyan",
      "title": "One Engine Step",
      "items": [
        "Scheduler picks decodes + prefill chunks under a token budget",
        "Model runs them in one forward over the paged KV cache",
        "Pure-decode steps replay a captured CUDA graph"
      ]
    },
    {
      "dot": "amber",
      "title": "Around The Engine",
      "items": [
        "tests/ and bench_kernels.py also import kernels/ directly",
        "Every number in README.md comes from results/"
      ]
    }
  ]
